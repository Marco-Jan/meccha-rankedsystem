@echo off
title MC-Ranked Feeder
cd /d "%~dp0"

REM ===================================================================
REM  Kopiere diese Datei zu START.bat und passe sie an.
REM  START.bat selbst ist in der .gitignore - hier stehen Zugangsdaten.
REM ===================================================================

REM Wo laeuft der Turnier-Server?
REM
REM   ACHTUNG: 8777 ist der LIVE-Server mit echten Turnierdaten.
REM   Zum Ausprobieren den Turnier-Server mit  set PORT=8778  auf einem
REM   eigenen Port starten und hier 8778 eintragen.
set TURNIER_URL=http://localhost:8777

REM Nur noetig, wenn der Turnier-Server mit TURNIER_KEY gestartet wurde.
REM set TURNIER_KEY=meingeheimeswort

REM Name der Punkteliste, so wie er im Admin steht (Tab 3).
set MC_SPIEL=Meccha 2026

REM Ab welcher Zuversicht automatisch eingetragen wird. Hoeher = mehr
REM Rueckfragen, aber weniger falsche Zuordnungen. 0.7 ist der Standard.
REM set MC_MIN_CONFIDENCE=0.7

npm run probelauf -- --namen "NorikoTv,Polosios" --punkte "12160,10579"
pause
